FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
CORS_ORIGINS=*

# LLM support is backend-selected only.
# Options: disabled, openai, chatgpt, google, local
LLM_PROVIDER=openai
LLM_TIMEOUT_SECONDS=240

# OpenAI / ChatGPT provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini provider
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-3.7-flash
GOOGLE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Local OpenAI-compatible provider, for example Ollama or LM Studio
LOCAL_LLM_MODEL=google/gemma-4-26b-a4b-qat
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=local
